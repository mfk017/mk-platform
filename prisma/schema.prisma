// Prisma Schema for Canter Platform - Multi-tenant Equestrian Booking Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Center {
  id                   String         @id @default(uuid())
  name_en              String
  name_ar              String
  slug                 String         @unique
  logo_url             String?
  description_en       String?
  description_ar       String?
  phone                String
  email                String
  whatsapp_number      String?        @default("+966501234567")
  location_url         String?        @default("https://maps.google.com/?q=Riyadh+Equestrian")
  city                 String
  bank_account_details String?        // Encrypted details
  vat_enabled          Boolean        @default(true)
  status               String         @default("active") // active | inactive | pending
  terms_accepted_at    DateTime?
  commission_rate      Float          @default(6.0)
  created_at           DateTime       @default(now())

  users                User[]
  services             Service[]
  horses               Horse[]
  trainers             Trainer[]
  schedule_slots       ScheduleSlot[]
  bookings             Booking[]
  payouts              Payout[]

  @@map("centers")
}

model User {
  id            String    @id @default(uuid())
  center_id     String?   // nullable - null for platform admins
  role          String    // center_admin | platform_admin
  email         String    @unique
  password_hash String
  name          String
  created_at    DateTime  @default(now())

  center        Center?   @relation(fields: [center_id], references: [id], onDelete: Cascade)

  @@map("users")
}

model Service {
  id               String         @id @default(uuid())
  center_id        String
  name_en          String
  name_ar          String
  price            Float
  original_price   Float?         // For packages strikethrough price
  discount_percent Float?         // e.g. 15 for 15% discount
  session_count    Int?           // e.g. 10 sessions for package
  duration_minutes Int
  category         String         // training | package | livery
  description_en   String?
  description_ar   String?
  image_url        String?
  created_at       DateTime       @default(now())

  center           Center         @relation(fields: [center_id], references: [id], onDelete: Cascade)
  schedule_slots   ScheduleSlot[]
  bookings         Booking[]

  @@map("services")
}

model Horse {
  id         String   @id @default(uuid())
  center_id  String
  name_en    String
  name_ar    String
  breed_en   String
  breed_ar   String
  age        Int
  image_url  String?
  created_at DateTime @default(now())

  center     Center   @relation(fields: [center_id], references: [id], onDelete: Cascade)

  @@map("horses")
}

model Trainer {
  id           String   @id @default(uuid())
  center_id    String
  name_en      String
  name_ar      String
  bio_en       String
  bio_ar       String
  specialty_en String?
  specialty_ar String?
  image_url    String?
  created_at   DateTime @default(now())

  center       Center   @relation(fields: [center_id], references: [id], onDelete: Cascade)

  @@map("trainers")
}

model ScheduleSlot {
  id           String    @id @default(uuid())
  center_id    String
  service_id   String
  start_time   DateTime
  end_time     DateTime
  capacity     Int       @default(5)
  booked_count Int       @default(0)
  created_at   DateTime  @default(now())

  center       Center    @relation(fields: [center_id], references: [id], onDelete: Cascade)
  service      Service   @relation(fields: [service_id], references: [id], onDelete: Cascade)
  bookings     Booking[]

  @@map("schedule_slots")
}

model Booking {
  id                   String       @id @default(uuid())
  center_id            String
  service_id           String
  slot_id              String
  reference_code       String       @unique
  customer_name        String
  customer_phone       String
  customer_email       String
  booking_price        Float
  platform_fee         Float        @default(6.00) // SAR 6 flat commission
  gateway_fee          Float        @default(0.00)
  net_amount_to_center Float        @default(0.00)
  payment_method       String       @default("mada")
  payment_status       String       @default("pending")
  moyasar_payment_id   String?      @unique
  payout_id            String?
  status               String       @default("confirmed")
  created_at           DateTime     @default(now())

  center               Center       @relation(fields: [center_id], references: [id], onDelete: Cascade)
  service              Service      @relation(fields: [service_id], references: [id], onDelete: Cascade)
  slot                 ScheduleSlot @relation(fields: [slot_id], references: [id], onDelete: Cascade)
  payout               Payout?      @relation(fields: [payout_id], references: [id], onDelete: SetNull)

  @@map("bookings")
}

model Payout {
  id             String    @id @default(uuid())
  center_id      String
  period_start   DateTime
  period_end     DateTime
  gross_amount   Float
  total_fees     Float
  net_amount     Float
  status         String    @default("pending")
  paid_at        DateTime?
  bank_reference String?
  created_at     DateTime  @default(now())

  center         Center    @relation(fields: [center_id], references: [id], onDelete: Cascade)
  bookings       Booking[]

  @@map("payouts")
}

model PlatformSettings {
  id                      String   @id @default("global")
  default_commission_rate Float    @default(6.0)
  updated_at              DateTime @updatedAt

  @@map("platform_settings")
}
